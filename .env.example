# Copy this file to .env and add your CSCS inference API key.
# --mock still runs the offline demo without a key.
MOCK_APERTUS=false

# Selected hackathon provider: CSCS, Apertus 1.5 70B (non-thinking).
# Use the complete chat completions URL, not only the API base URL.
APERTUS_API_URL=https://api.inference.cscs.ch/v1/chat/completions
APERTUS_API_KEY=
APERTUS_MODEL=swiss-ai/Apertus-v1.5-70B

# To compare the smaller model later:
# APERTUS_MODEL=swiss-ai/Apertus-v1.5-8B

# Alternative provider: Public AI (requires its own API key).
# APERTUS_API_URL=https://api.publicai.co/v1/chat/completions
# APERTUS_API_KEY=your_public_ai_api_key
# APERTUS_MODEL=swiss-ai/apertus-v1.5-8b
